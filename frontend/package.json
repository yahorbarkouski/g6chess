{
  "name": "g6explanation-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node scripts/copy-stockfish.mjs",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "vitest run",
    "contracts:generate": "openapi-typescript ../contracts/openapi.json -o src/generated/g6-api.ts && biome format --write src/generated/g6-api.ts",
    "contracts:check": "bun run contracts:generate && git diff --exit-code -- ../contracts/openapi.json src/generated/g6-api.ts",
    "perf:render": "VITE_PRINT_PERF_BASELINE=1 vitest run src/components/analysis/AnalysisWorkspace.performance.test.tsx --reporter=verbose",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@ultrachess/core": "1.1.3",
    "@ultrachess/pieces": "1.1.1",
    "@ultrachess/react": "1.2.3",
    "@ultrachess/themes": "1.1.1",
    "@vercel/analytics": "^2.0.1",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "stockfish": "^18.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "torph": "^0.0.9",
    "ultrachess": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@ultrachess/core": "1.1.3",
    "brace-expansion": "5.0.9",
    "undici": "7.29.0"
  }
}
